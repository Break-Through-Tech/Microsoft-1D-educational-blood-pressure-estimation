{
  "sample_rate_hz": 125,
  "window_samples": 625,
  "seed": 2026,
  "cleaning": {
    "max_zero_fraction": 0.05,
    "min_std": 1e-06,
    "zero_policy": "linear_interpolation_with_constant_edge_extension",
    "ppg_method": "elgendi",
    "abp_low_pass_hz": 40,
    "abp_filter_order": 4,
    "sbp_range": [
      60.0,
      250.0
    ],
    "dbp_range": [
      30.0,
      150.0
    ]
  },
  "paths": {
    "raw_dir": "data/raw",
    "split_config": "configs/split.json",
    "prepared_archive": "data/derived/gradient_boosting/processed_dataset.npz",
    "output_dir": "data/derived/gradient_boosting/run"
  },
  "workers": 8,
  "batch_size": 2048,
  "gradient_boosting": {
    "loss": "absolute_error",
    "learning_rate": 0.1,
    "max_iter": 100,
    "max_leaf_nodes": 31,
    "min_samples_leaf": 20,
    "l2_regularization": 1.0,
    "early_stopping": false
  },
  "ridge_alpha": 100.0,
  "tuning": {
    "learning_rates": [
      0.05,
      0.1
    ],
    "leaf_counts": [
      15,
      31
    ]
  },
  "bootstrap_samples": 1000
}
